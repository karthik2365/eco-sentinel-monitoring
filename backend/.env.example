# Copy to .env on a fresh installation; keep credentials local.
OPENROUTER_API_KEY=
# The free router selects an available model compatible with the request.
# You can set specific OpenRouter model IDs if your account has access.
VISION_MODEL=openrouter/free
TEXT_MODEL=openrouter/free
GEE_PROJECT_ID=agentathon
# GEE_SERVICE_ACCOUNT=/absolute/path/to/service-key.json
# A stable local signing secret is generated automatically in .local-secret.
# SECRET_KEY=your-own-long-random-secret
# DATABASE_URL=sqlite:///eco_sentinel_local.db
PORT=5050
FLASK_DEBUG=false
